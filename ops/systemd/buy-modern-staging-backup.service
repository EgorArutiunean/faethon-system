[Unit]
Description=Buy Modern staging validated PostgreSQL backup
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/buy-modern/current
EnvironmentFile=/etc/buy-modern/staging-backup.env
ExecStart=/bin/sh /opt/buy-modern/current/scripts/backup_postgres.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/backups/buy-staging /var/lib/node_exporter/textfile_collector
UMask=0077

[Install]
WantedBy=multi-user.target
