POSTGRES_DB=buy_modern
POSTGRES_USER=buy
POSTGRES_PASSWORD=buy
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

APP_ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=json
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0
RELEASE_VERSION=local
DATABASE_URL=postgresql+psycopg://buy:buy@postgres:5432/buy_modern
JWT_SECRET_KEY=change-me-dev-only
AUTH_SECRET_KEY=change-me-dev-only
ACCESS_TOKEN_MINUTES=60
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
IMPORT_MAX_BYTES=10485760
IMPORT_MAX_ROWS=20000
IMPORT_XLSX_MAX_UNCOMPRESSED_BYTES=52428800
IMPORT_XLSX_MAX_ENTRIES=1000
IMPORT_XLSX_MAX_COMPRESSION_RATIO=100
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_BASE_URL=/api/v1
VITE_API_PROXY_TARGET=http://backend:8000
VITE_DEMO_MODE=true

DEMO_ADMIN_EMAIL=admin@example.com
DEMO_ADMIN_PASSWORD=admin123
