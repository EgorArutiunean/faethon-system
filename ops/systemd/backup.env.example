BACKUP_COMPOSE_PROJECT=buy-modern-production
BACKUP_DIR=/var/backups/buy-modern
BACKUP_METRICS_FILE=/var/lib/node_exporter/textfile_collector/buy_modern_backup.prom
BACKUP_RETENTION_DAYS=14
OFFSITE_BACKUP_ENABLED=true
OFFSITE_METRICS_FILE=/var/lib/node_exporter/textfile_collector/buy_modern_offsite_backup.prom
RESTIC_REPOSITORY=s3:s3.example.com/buy-modern-production
RESTIC_PASSWORD_FILE=/etc/buy-modern/restic-password
RESTIC_BACKUP_TAG=buy-modern-postgres
RESTIC_BACKUP_HOST=buy-modern-production
# Add provider-specific credentials here, for example AWS_ACCESS_KEY_ID and
# AWS_SECRET_ACCESS_KEY. Keep this file root-owned with mode 0600.
