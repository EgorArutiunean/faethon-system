# Replace CHANGE_ME with the staging PostgreSQL Docker Compose project label.
BACKUP_COMPOSE_PROJECT=CHANGE_ME
BACKUP_DIR=/var/backups/buy-staging
BACKUP_METRICS_FILE=/var/lib/node_exporter/textfile_collector/buy_modern_staging_backup.prom
# Keep deletion disabled until a retention policy is explicitly approved.
BACKUP_RETENTION_DAYS=0
