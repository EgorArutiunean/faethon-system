POSTGRES_DB=buy_modern
POSTGRES_USER=buy_modern
POSTGRES_PASSWORD=replace-with-strong-password

APP_ENV=production
LOG_LEVEL=INFO
LOG_FORMAT=json
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.05
RELEASE_VERSION=replace-with-release-or-git-sha
DATABASE_URL=postgresql+psycopg://buy_modern:replace-with-strong-password@postgres:5432/buy_modern
AUTH_SECRET_KEY=replace-with-at-least-32-random-characters
ACCESS_TOKEN_MINUTES=60
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
IMPORT_MAX_BYTES=10485760
IMPORT_MAX_ROWS=20000
IMPORT_XLSX_MAX_UNCOMPRESSED_BYTES=52428800
IMPORT_XLSX_MAX_ENTRIES=1000
IMPORT_XLSX_MAX_COMPRESSION_RATIO=100
CORS_ORIGINS=https://your-server-domain

VITE_API_BASE_URL=/api/v1
VITE_DEMO_MODE=false
HTTP_PORT=80
BACKEND_IMAGE=buy-modern-backend-prod:local
